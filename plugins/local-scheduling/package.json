{
  "name": "@jupyter-ml/local-scheduling",
  "version": "0.1.0",
  "description": "JupyterLab extension for local pipeline scheduling and task management",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension"
  ],
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "files": [
    "lib/**/*.{d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf}",
    "src/**/*.{ts,tsx}",
    "style/**/*.{css,eot,gif,html,jpg,json,png,svg,woff2,ttf}"
  ],
  "scripts": {
    "build": "jlpm build:lib && jlpm build:labextension",
    "build:labextension": "jupyter labextension build .",
    "build:lib": "tsc --sourceMap",
    "clean": "rimraf lib tsconfig.tsbuildinfo",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@jupyterlab/application": "^4.4.2",
    "@jupyterlab/apputils": "^4.4.2",
    "@jupyterlab/coreutils": "^6.4.2",
    "@jupyterlab/docregistry": "^4.4.2",
    "@jupyterlab/services": "^7.4.2",
    "@jupyterlab/ui-components": "^4.4.2",
    "@lumino/messaging": "^2.0.3",
    "@lumino/widgets": "^2.7.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@glen/jest-raw-loader": "^2.0.0",
    "@jupyterlab/builder": "^4.4.2",
    "@jupyterlab/testing": "^4.4.2",
    "@jupyterlab/testutils": "^4.4.2",
    "@types/jest": "^29.2.0",
    "@types/react": "18.2.8",
    "@types/react-dom": "18.2.4",
    "identity-obj-proxy": "^3.0.0",
    "isomorphic-fetch": "^3.0.0",
    "jest": "^29.2.0",
    "rimraf": "~5.0.5",
    "ts-jest": "^29.3.2",
    "typescript": "~5.5.4"
  },
  "resolutions": {
    "@types/react": "18.2.8"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "jupyter_ml_scheduling/labextension"
  }
}
